# Purpose: Provider requirements for the security module.
# Section: PROMPT.md §7 — Security (Key Vault, private endpoints, DNS)
# Last updated: 2026-06-11
#
# Mirrors avm-res-keyvault-vault 0.10.2 provider requirements (confirmed on the Terraform Registry).

terraform {
  required_version = ">= 1.9, < 2.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.4"
    }
    modtm = {
      source  = "Azure/modtm"
      version = "~> 0.3"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.5"
    }
    time = {
      source  = "hashicorp/time"
      version = "~> 0.9"
    }
  }
}
