# Purpose: Provider requirements for the session-hosts module.
# Section: PROMPT.md §9 — Session hosts
# Last updated: 2026-06-11
#
# Mirrors avm-res-compute-virtualmachine 0.21.0 provider requirements (confirmed on the Registry).

terraform {
  required_version = ">= 1.9, < 2.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.4"
    }
    modtm = {
      source  = "Azure/modtm"
      version = "~> 0.3"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}
