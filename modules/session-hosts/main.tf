# Purpose: AVD session-host VMs + Entra ID join + AVD agent registration.
# Section: PROMPT.md §9 — Session hosts
# Last updated: 2026-06-11
#
# AVM: avm-res-compute-virtualmachine 0.21.0 (for_each per host).
#
# UNVERIFIED: the AVD agent DSC extension's modulesUrl, DSC type_handler_version, and the
# Configuration_*.zip artifact change over time — confirm against current Microsoft AVD docs before apply.
# Extension ordering (Entra join before the agent DSC) is enforced via deploy_sequence (1 then 2).
#
# NOTE: the AVM VM module defaults encryption_at_host_enabled = true — the subscription must have the
# Microsoft.Compute/EncryptionAtHost feature registered or apply fails (tracked in OPEN-QUESTIONS.md).

locals {
  # One entry per session host, keyed by zero-padded index, spread across availability zones.
  session_hosts = {
    for i in range(var.session_host_count) :
    format("%02d", i + 1) => {
      zone = var.availability_zones[i % length(var.availability_zones)]
    }
  }

  # Short, Windows-safe VM name base (computer name <= 15 chars): vm + de-dashed prefix (trimmed).
  vm_name_base = "vm${substr(replace(lower(var.name_prefix), "-", ""), 0, 9)}"

  # VM extensions: optional Entra ID join, then the AVD agent/boot-loader DSC extension.
  extensions = merge(
    var.entra_id_join ? {
      aad_join = {
        name                 = "AADLoginForWindows"
        publisher            = "Microsoft.Azure.ActiveDirectory"
        type                 = "AADLoginForWindows"
        type_handler_version = "2.0"
        deploy_sequence      = 1 # Entra join must complete before the agent DSC (sequence 2).
        settings             = null
        protected_settings   = null
      }
    } : {},
    {
      avd_agent_dsc = {
        name                 = "Microsoft.PowerShell.DSC"
        publisher            = "Microsoft.Powershell"
        type                 = "DSC"
        type_handler_version = "2.73"
        deploy_sequence      = 2
        settings = jsonencode({
          modulesUrl            = "https://wvdportalstorageblob.blob.core.windows.net/galleryartifacts/Configuration_1.0.02790.438.zip" # UNVERIFIED
          configurationFunction = "Configuration.ps1\\AddSessionHost"
          properties = {
            hostPoolName = var.host_pool_name
            aadJoin      = var.entra_id_join
          }
        })
        protected_settings = jsonencode({
          properties = {
            registrationInfoToken = var.host_pool_registration_token
          }
        })
      }
    },
    {
      # Azure Monitor Agent — collects the DCR perf counters + events for AVD Insights (§10).
      azure_monitor_agent = {
        name                 = "AzureMonitorWindowsAgent"
        publisher            = "Microsoft.Azure.Monitor"
        type                 = "AzureMonitorWindowsAgent"
        type_handler_version = "1.0"
        deploy_sequence      = 3
        settings             = null
        protected_settings   = null
      }
    }
  )
}

module "session_host" {
  source  = "Azure/avm-res-compute-virtualmachine/azurerm"
  version = "0.21.0"

  for_each = local.session_hosts

  name                = "${local.vm_name_base}${each.key}"
  location            = var.location
  resource_group_name = var.resource_group_name
  zone                = each.value.zone
  os_type             = "Windows"
  sku_size            = var.vm_size
  tags                = var.tags

  # Local admin account — password generated by the module (kept out of the repo; wire to Key Vault later).
  account_credentials = {
    admin_credentials = {
      username                           = var.admin_username
      generate_admin_password_or_ssh_key = true
    }
    # Windows requires password auth enabled (the module generates the password above).
    password_authentication_disabled = true
  }

  source_image_reference = var.image_reference

  os_disk = {
    caching              = "ReadWrite"
    storage_account_type = var.os_disk_storage_account_type
  }

  network_interfaces = {
    nic0 = {
      name = "nic-${local.vm_name_base}${each.key}"
      ip_configurations = {
        ipconfig0 = {
          name                          = "ipconfig0"
          private_ip_subnet_resource_id = var.subnet_resource_id
        }
      }
      application_security_groups = var.asg_resource_id != "" ? {
        asg = { application_security_group_resource_id = var.asg_resource_id }
      } : {}
    }
  }

  # System-assigned identity (required by the AADLoginForWindows extension for Entra ID join).
  managed_identities = {
    system_assigned = true
  }

  extensions = local.extensions
}
