#!/usr/bin/env bash
# Git pre-commit hook — deterministic "testing" half of the review gate.
# Hard-fails the commit if Terraform is not formatted, or if an initialized root fails validate.
# Enable once per clone:  git config core.hooksPath .githooks
#
# (The code-reviewer half is enforced separately by the Claude Code PreToolUse hook.)

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Locate terraform: PATH first, then this machine's known install.
if command -v terraform >/dev/null 2>&1; then
  TF=terraform
elif [ -x "$HOME/tools/terraform/terraform.exe" ]; then
  TF="$HOME/tools/terraform/terraform.exe"
elif [ -x "$HOME/tools/terraform/terraform" ]; then
  TF="$HOME/tools/terraform/terraform"
else
  echo "pre-commit: terraform not found on PATH — skipping fmt/validate." >&2
  exit 0
fi

echo "pre-commit: terraform fmt -check -recursive"
if ! "$TF" fmt -check -recursive >/dev/null; then
  echo "pre-commit: FAILED — files are not formatted. Run 'terraform fmt -recursive' and re-stage." >&2
  exit 1
fi

# Validate only roots that are already initialized (validate needs providers/modules present).
status=0
for root in bootstrap landing-zones/avd-workload; do
  if [ -d "$root/.terraform" ]; then
    echo "pre-commit: terraform validate ($root)"
    if ! "$TF" -chdir="$root" validate >/dev/null; then
      echo "pre-commit: FAILED — 'terraform validate' errors in $root." >&2
      status=1
    fi
  else
    echo "pre-commit: $root not initialized — skipping validate (run 'terraform init')." >&2
  fi
done
exit $status
